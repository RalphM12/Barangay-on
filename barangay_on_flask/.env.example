# ---- Barangay-On settings --------------------------------------------------
SECRET_KEY=change-me-to-any-long-random-text

# MySQL connection. Defaults match a fresh MySQL / XAMPP install.
#   MySQL installer / Docker (see docker-compose.yml): DB_PASSWORD = the password you chose (docker-compose uses: root)
#   XAMPP:  DB_PASSWORD empty        MAMP:  DB_PASSWORD=root and DB_PORT=8889
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=barangay_on
